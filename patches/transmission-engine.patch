+static uint64_t getPieceWindowBytes()
+{
+    static uint64_t const bytes = []() {
+        char const* env = getenv("TRANSMISSION_PIECE_WINDOW_MB");
+        long const mb = (env != nullptr) ? atol(env) : 16;
+        return mb > 0 ? static_cast<uint64_t>(mb) * 1048576 : uint64_t{ 0 };
+    }();
+    return bytes;
+}
+
+static void updatePieceWindow(tr_torrent const* tor)
+{
+    tr_info const* const inf = &tor->info;
+    weightWindowBytes = getPieceWindowBytes();
+    weightFileFrontier.clear();
+
+    if (weightWindowBytes == 0)
+    {
+        return;
+    }
+
+    weightFileFrontier.assign(inf->fileCount, 0);
+
+    for (tr_piece_index_t i = 0; i < inf->pieceCount; ++i)
+    {
+        if (!tr_torrentPieceIsComplete(tor, i))
+        {
+            continue;
+        }
+
+        tr_file_index_t fileIndex = 0;
+        uint64_t fileOffset = 0;
+        tr_ioFindFileLocation(tor, i, 0, &fileIndex, &fileOffset);
+        uint64_t const end = std::min<uint64_t>(fileOffset + inf->pieceSize, inf->files[fileIndex].length);
+        weightFileFrontier[fileIndex] = std::max(weightFileFrontier[fileIndex], end);
+    }
+}
+
+static int pieceWindowRank(tr_torrent const* tor, tr_piece_index_t piece)
+{
+    if (weightWindowBytes == 0 || weightFileFrontier.empty())
+    {
+        return 0;
+    }
+
+    tr_file_index_t fileIndex = 0;
+    uint64_t fileOffset = 0;
+    tr_ioFindFileLocation(tor, piece, 0, &fileIndex, &fileOffset);
+    uint64_t const frontier = weightFileFrontier[fileIndex];
+
+    if (fileOffset <= frontier + weightWindowBytes)
+    {
+        return 0;
+    }
+
+    uint64_t over = (fileOffset - frontier) / weightWindowBytes;
+    int rank = 1;
+
+    while (over > 1)
+    {
+        over >>= 1;
+        ++rank;
+    }
+
+    return rank;
+}
