+void tr_swarm::WishlistMediator::refresh_piece_window()
+{
+    window_bytes_ = tr_ioPieceWindowBytes();
+    file_frontier_.clear();
+    if (window_bytes_ == 0U || !tor_.has_metainfo())
+    {
+        return;
+    }
+
+    file_frontier_.assign(tor_.file_count(), 0U);
+    for (tr_piece_index_t piece = 0U, n = tor_.piece_count(); piece < n; ++piece)
+    {
+        if (!tor_.has_piece(piece))
+        {
+            continue;
+        }
+
+        auto const [file_index, file_offset] = tor_.file_offset(tor_.piece_loc(piece));
+        auto const end = std::min<uint64_t>(file_offset + tor_.piece_size(piece), tor_.file_size(file_index));
+        file_frontier_[file_index] = std::max(file_frontier_[file_index], end);
+    }
+}
+
+int tr_swarm::WishlistMediator::piece_window_rank(tr_piece_index_t piece) const
+{
+    if (window_bytes_ == 0U || file_frontier_.empty())
+    {
+        return 0;
+    }
+
+    auto const [file_index, file_offset] = tor_.file_offset(tor_.piece_loc(piece));
+    if (file_index >= std::size(file_frontier_))
+    {
+        return 0;
+    }
+
+    auto const frontier = file_frontier_[file_index];
+    if (file_offset <= frontier + window_bytes_)
+    {
+        return 0;
+    }
+
+    auto over = (file_offset - frontier) / window_bytes_;
+    auto rank = 1;
+    while (over > 1U)
+    {
+        over >>= 1U;
+        ++rank;
+    }
+
+    return rank;
+}
