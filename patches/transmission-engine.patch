+static uint64_t constexpr SYNC_WRITES_THRESHOLD = 2 * 1048576;
+
+static std::atomic<bool> syncInFlight{ false };
+
+static bool syncFileAsync(tr_sys_file_t fd)
+{
+    bool expected = false;
+
+    if (!syncInFlight.compare_exchange_strong(expected, true))
+    {
+        return false;
+    }
+
+    int const copy = dup(fd);
+
+    if (copy < 0)
+    {
+        syncInFlight = false;
+        return false;
+    }
+
+    std::thread([copy]() {
+        fsync(copy);
+        close(copy);
+        syncInFlight = false;
+    }).detach();
+
+    return true;
+}
+
+static bool syncWritesEnabled()
+{
+    static bool const enabled = []() {
+        char const* env = getenv("TRANSMISSION_SYNC_WRITES");
+        return env == nullptr || env[0] != '0';
+    }();
+    return enabled;
+}
