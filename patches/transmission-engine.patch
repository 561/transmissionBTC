+static uint64_t maxDirtyBytes()
+{
+    static uint64_t const value = []() {
+        char const* env = getenv("TRANSMISSION_MAX_DIRTY_MB");
+        long const mb = env != nullptr ? atol(env) : 32;
+        return static_cast<uint64_t>(mb > 0 ? mb : 32) * 1048576;
+    }();
+    return value;
+}
+
+static uint64_t readDirtyBytes()
+{
+    FILE* f = fopen("/proc/meminfo", "r");
+
+    if (f == nullptr)
+    {
+        return 0;
+    }
+
+    char line[128];
+    uint64_t total = 0;
+
+    while (fgets(line, sizeof(line), f) != nullptr)
+    {
+        unsigned long long kb = 0;
+
+        if (sscanf(line, "Dirty: %llu kB", &kb) == 1 || sscanf(line, "Writeback: %llu kB", &kb) == 1)
+        {
+            total += kb * 1024;
+        }
+    }
+
+    fclose(f);
+    return total;
+}
+
+static void refreshDownloadLimit(void* vsession)
+{
+    tr_sessionRefreshDownloadLimit(static_cast<tr_session*>(vsession));
+}
+
+static void setDownloadThrottled(bool throttled)
+{
+    tr_session* session = throttleSession.load();
+
+    if (session != nullptr && downloadThrottled.exchange(throttled) != throttled)
+    {
+        tr_runInEventThread(session, refreshDownloadLimit, session);
+    }
+}
+
+bool tr_ioDownloadThrottled()
+{
+    return downloadThrottled.load();
+}
+
+void tr_ioShutdown()
+{
+    throttleSession = nullptr;
+    downloadThrottled = false;
+}
+
+static void startDirtyMonitor(tr_session* session)
+{
+    throttleSession = session;
+    bool expected = false;
+
+    if (!monitorStarted.compare_exchange_strong(expected, true))
+    {
+        return;
+    }
+
+    std::thread([]() {
+        for (;;)
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));
+
+            if (throttleSession.load() == nullptr)
+            {
+                continue;
+            }
+
+            uint64_t const dirty = readDirtyBytes();
+
+            if (dirty >= maxDirtyBytes())
+            {
+                setDownloadThrottled(true);
+            }
+            else if (dirty < maxDirtyBytes() / 2)
+            {
+                setDownloadThrottled(false);
+            }
+        }
+    }).detach();
+}
