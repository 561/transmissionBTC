index 0000000..074a419
--- /dev/null
+++ b/libtransmission/tv-io.cc
@@ -0,0 +1,128 @@
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+#include "libtransmission/transmission.h"
+
+#include "libtransmission/session.h"
+#include "libtransmission/tv-io.h"
+
+namespace
+{
+std::atomic<bool> download_throttled{ false };
+std::atomic<bool> io_suspended{ false };
+std::atomic<tr_session*> throttle_session{ nullptr };
+std::atomic<bool> monitor_started{ false };
+
+uint64_t env_megabytes(char const* name, long fallback, bool allow_zero)
+{
+    char const* const env = getenv(name);
+    long const mb = env != nullptr ? atol(env) : fallback;
+    if (mb > 0)
+    {
+        return static_cast<uint64_t>(mb) * 1048576U;
+    }
+    return allow_zero ? 0U : static_cast<uint64_t>(fallback) * 1048576U;
+}
+
+uint64_t max_dirty_bytes()
+{
+    static uint64_t const value = env_megabytes("TRANSMISSION_MAX_DIRTY_MB", 32, false);
+    return value;
+}
+
+uint64_t read_dirty_bytes()
+{
+    FILE* const f = fopen("/proc/meminfo", "r");
+    if (f == nullptr)
+    {
+        return 0;
+    }
+
+    char line[128];
+    uint64_t total = 0;
+    while (fgets(line, sizeof(line), f) != nullptr)
+    {
+        unsigned long long kb = 0;
+        if (sscanf(line, "Dirty: %llu kB", &kb) == 1 || sscanf(line, "Writeback: %llu kB", &kb) == 1)
+        {
+            total += kb * 1024U;
+        }
+    }
+
+    fclose(f);
+    return total;
+}
+
+void set_download_throttled(bool const throttled)
+{
+    tr_session* const session = throttle_session.load();
+    if (session != nullptr && download_throttled.exchange(throttled) != throttled)
+    {
+        session->run_in_session_thread([session]() { tr_sessionRefreshDownloadLimit(session); });
+    }
+}
+}
+
+bool tr_ioDownloadThrottled()
+{
+    return download_throttled.load() || io_suspended.load();
+}
+
+bool tr_ioSuspended()
+{
+    return io_suspended.load();
+}
+
+void tr_ioSetSuspended(bool const suspended)
+{
+    io_suspended = suspended;
+}
+
+void tr_ioShutdown()
+{
+    throttle_session = nullptr;
+    download_throttled = false;
+}
+
+void tr_ioStartDirtyMonitor(tr_session* const session)
+{
+    throttle_session = session;
+    bool expected = false;
+    if (!monitor_started.compare_exchange_strong(expected, true))
+    {
+        return;
+    }
+
+    std::thread(
+        []()
+        {
+            for (;;)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+                if (throttle_session.load() == nullptr)
+                {
+                    continue;
+                }
+
+                uint64_t const dirty = read_dirty_bytes();
+                if (dirty >= max_dirty_bytes())
+                {
+                    set_download_throttled(true);
+                }
+                else if (dirty < max_dirty_bytes() / 2U)
+                {
+                    set_download_throttled(false);
+                }
+            }
+        })
+        .detach();
+}
+
+uint64_t tr_ioPieceWindowBytes()
+{
+    static uint64_t const value = env_megabytes("TRANSMISSION_PIECE_WINDOW_MB", 16, true);
+    return value;
+}
