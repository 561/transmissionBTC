+void tr_sessionGetPeerSocketStats(tr_session* session, int* sockets, int* limit, int* peers, int* handshakes)
+{
+    auto const lock = session->unique_lock();
+
+    *sockets = static_cast<int>(tr_peer_socket::open_count());
+    *limit = static_cast<int>(session->peerLimit());
+    *peers = 0;
+    *handshakes = 0;
+
+    tr_peerMgr const* manager = nullptr;
+    for (auto const* const tor : session->torrents())
+    {
+        manager = tor->swarm->manager;
+        *peers += static_cast<int>(tor->swarm->peerCount());
+
+        for (auto const& [socket_address, peer_info] : tor->swarm->connectable_pool)
+        {
+            if (peer_info->has_handshake())
+            {
+                ++*handshakes;
+            }
+        }
+    }
+
+    if (manager != nullptr)
+    {
+        *handshakes += static_cast<int>(std::size(manager->incoming_handshakes));
+    }
+}
